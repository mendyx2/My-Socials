# Copy to .env.local and fill in. Never commit real keys.

# Order of providers to try. The first one that works is used.
LLM_PROVIDERS=gemini,groq

# Google AI Studio key: https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
# Model names change often. Run `npm run models` to list what your key can use.
GEMINI_MODEL=gemini-flash-latest

# Groq key: https://console.groq.com/keys (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional local fallback (https://ollama.com), no key needed.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# How many ideas per run.
IDEAS_PER_DAY=5

# ---------------------------------------------------------------------------
# Only needed when the app is online (Netlify). Set these in Netlify instead:
# Site configuration → Environment variables.
#
# APP_PASSWORD=          # at least 12 characters; you type it once per device
# STORAGE=netlify        # tells the app to use Netlify Blobs
# GEMINI_API_KEY / GROQ_API_KEY as above
#
# For `npm run sync` and the daily GitHub Action (copy data to/from Netlify):
# NETLIFY_SITE_ID=       # Netlify → Site configuration → Site details → Site ID
# NETLIFY_AUTH_TOKEN=    # Netlify → User settings → Applications → Personal access tokens
